# Required for admin authentication in Netlify production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
# Optional AI providers (server-side only)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: app base URL
APP_URL=https://YOUR_SITE.netlify.app
